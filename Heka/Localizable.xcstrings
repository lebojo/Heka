          }
        }
      }
    },
    "The organization is still unreadable. The original file is kept: %@\n%@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’organisation reste illisible. Le fichier original est conservé : %1$@\n%2$@"
          }
        }
      }
    },
    "The output exceeds the display limit. Open this content in your editor." : {
