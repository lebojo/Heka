    "The Mac’s organization is read-only." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’organisation du Mac est en lecture seule."
          }
        }
      }
    },
    "The operation was applied in memory, but saving it failed. Retry saving in the app before running the command again. %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
