        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thème"
          }
        }
      }
    },
    "These checks are for the remote commit of the merge request, which differs from the local HEAD." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces checks concernent le commit distant de la merge request, différent du HEAD local."
