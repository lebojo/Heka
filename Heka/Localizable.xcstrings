            "state" : "translated",
            "value" : "La commande du terminal tourne encore après %lld secondes."
          }
        }
      }
    },
    "The worktree “%@” has uncommitted changes or untracked files. Run again with --force to erase them." : {
      "localizations" : {
        "fr" : {
