          }
        }
      }
    },
    "The terminal is still printing output after %lld seconds." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le terminal affiche encore du texte après %lld secondes."
          }
        }
      }
    },
    "The terminal isn’t at the shell prompt. Finish the current command before launching an agent." : {
      "localizations" : {
